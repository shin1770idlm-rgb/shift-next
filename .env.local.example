# 全体管理画面（/admin）のログイン情報。ここから店舗を追加・削除できます
SUPER_ADMIN_USER=admin
SUPER_ADMIN_PASSWORD=eminect
# （任意）ログインCookieの署名用の鍵。未設定なら SUPER_ADMIN_PASSWORD を使います
# SESSION_SECRET=長いランダムな文字列
# （任意・従来の方法）環境変数で店舗を固定で登録する場合
# STORES='[{"id":"shop1","name":"1号店","user":"shop1-admin","password":"強いパスワード1"}]'
# ローカル開発時のみ
TZ=Asia/Tokyo
